// main.rc.in — ресурсы Windows-клиента: версия файла и подпись издателя.
// Значения @...@ подставляет build_windows.sh (числа берёт из tools/version.py).
// Константы вписаны числами, чтобы файл собирался одним zig rc без заголовков MSVC:
//   VOS_NT_WINDOWS32 = 0x00040004, VFT_APP = 1, VFT2_UNKNOWN = 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @FILEVERSION@
 PRODUCTVERSION @FILEVERSION@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x00040004L
 FILETYPE       0x00000001L
 FILESUBTYPE    0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "@COMPANY@"
            VALUE "FileDescription",  "CRM — приём заявок на заправку картриджей и ремонт оргтехники"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "CRM-Windows"
            VALUE "LegalCopyright",   "© CRM Kartridzh"
            VALUE "OriginalFilename", "CRM-Windows.exe"
            VALUE "ProductName",      "CRM Windows Client"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

// МАНИФЕСТ: обычные права (не администратор) + современные контролы + DPI
1 24 "main.manifest"
