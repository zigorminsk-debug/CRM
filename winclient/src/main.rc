// main.rc.in — ресурсы Windows-клиента: версия файла и подпись издателя.
// Значения @...@ подставляет build_windows.sh (числа берёт из tools/version.py).
// Константы вписаны числами, чтобы файл собирался одним zig rc без заголовков MSVC:
//   VOS_NT_WINDOWS32 = 0x00040004, VFT_APP = 1, VFT2_UNKNOWN = 0

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,15
 PRODUCTVERSION 1,0,0,15
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x00040004L
 FILETYPE       0x00000001L
 FILESUBTYPE    0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "Cartridge Engineer"
            VALUE "FileDescription",  "Cartridge Engineer — приём заявок на заправку картриджей и ремонт оргтехники"
            VALUE "FileVersion",      "1.0.15"
            VALUE "InternalName",     "Cartridge Engineer"
            VALUE "LegalCopyright",   "© Cartridge Engineer"
            VALUE "OriginalFilename", "CRM-Windows.exe"
            VALUE "ProductName",      "Cartridge Engineer"
            VALUE "ProductVersion",   "1.0.15"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END

// МАНИФЕСТ: обычные права (не администратор) + современные контролы + DPI
1 24 "main.manifest"
