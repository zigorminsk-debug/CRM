<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/deliveryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deliveryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B45309"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/deliveryAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/deliveryContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/deliveryNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDelivered"
            android:minWidth="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#166534"
            android:text="Доставлено"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDeliveryPostpone"
            android:minWidth="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Перенести" />

        <Button
            android:id="@+id/btnDeliveryNav"
            android:minWidth="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:maxLines="1"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Маршрут" />
    </LinearLayout>
</LinearLayout>
